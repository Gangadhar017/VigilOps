# VigilOps reverse proxy (Caddy)
#
# The only public entry point of the platform:
#   /api/*          -> FastAPI backend (internal network)
#   /orbitcrate/*   -> the demonstration application's storefront (internal network)
#   everything else -> the React single-page application
#
# Only paths under /api/ reach the backend (including the unauthenticated
# /api/health and /api/version, which disclose only a status in production).
# The backend's /metrics, /docs, /openapi.json and /health/*, Prometheus,
# Alertmanager, PostgreSQL and the worker are NOT reachable through this proxy.
#
# SITE_ADDRESS
#   local (default)  ":80"                 plain HTTP behind http://localhost:8080
#   production       "vigilops.example.com"  Caddy obtains and renews a TLS certificate
#                                            automatically and redirects HTTP to HTTPS
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		# Honoured by browsers over HTTPS only; ignored on the plain-HTTP local stack.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Simple check for load balancers / uptime monitors (does not touch the backend).
	handle /healthz {
		respond "ok" 200
	}

	# The pages ask this address when the API does not answer.  On a static host in
	# front of a server that sleeps when idle it leads to that server and starts it
	# (frontend/vercel.json); here nothing sleeps, so there is nothing to do.
	handle /wake {
		respond 204
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# OrbitCrate, the monitored demonstration application, at its own address.
	# Only its page, its static files and its store API are routed.  Its control
	# endpoints (/internal/*), /metrics and /health/* are not reachable here.
	redir /orbitcrate /orbitcrate/ 308
	handle_path /orbitcrate/* {
		@visitor path / /static/* /api/*
		handle @visitor {
			request_body {
				max_size 4KB
			}
			reverse_proxy test-app:8001
		}
		handle {
			respond "Not Found" 404
		}
	}

	handle {
		root * /srv/www
		# Hashed build assets can be cached for a long time; index.html must not be.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
