# =============================================================================
# VigilOps environment configuration
#
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# The values below let the LOCAL DEVELOPMENT stack start immediately.  They are
# public placeholders: generate your own before sharing the machine or deploying
# anywhere (python scripts/generate_env.py writes a .env with random secrets).
# In production mode the backend refuses to start while "change-me" values remain.
# Never commit your real .env file.
# =============================================================================

# --- Mode --------------------------------------------------------------------
# development | production
ENVIRONMENT=development
# Port of the web application on this machine: http://localhost:8080
VIGILOPS_HTTP_PORT=8080
# Interface the web port listens on. 127.0.0.1 = this computer only (default).
# Use 0.0.0.0 to reach the local stack from other devices - plain HTTP, trusted networks only.
VIGILOPS_BIND_ADDRESS=127.0.0.1

# --- Database (PostgreSQL) -----------------------------------------------------
# Use only letters, digits, "-" and "_" in the password (it is placed in a URL).
POSTGRES_USER=vigilops
POSTGRES_PASSWORD=dev-only-change-me-db-password
POSTGRES_DB=vigilops

# --- Security ------------------------------------------------------------------
# JWT signing key, at least 32 characters.
SECRET_KEY=dev-only-change-me-jwt-signing-key-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Shared token Alertmanager presents to the incident webhook (at least 16 characters).
ALERT_WEBHOOK_TOKEN=dev-only-change-me-webhook-token

# --- First accounts --------------------------------------------------------------
# Created on first start only if no account with that e-mail exists yet.
# Password policy: 10+ characters, upper and lower case letters and a digit.
BOOTSTRAP_ADMIN_EMAIL=admin@vigilops.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-2026
BOOTSTRAP_OPERATOR_EMAIL=operator@vigilops.local
BOOTSTRAP_OPERATOR_PASSWORD=ChangeMe-Operator-2026

# --- Demonstration environment -----------------------------------------------------
# Enables fault injection and sample-configuration reset for Administrators.
# Off when ENVIRONMENT=production (compose.prod.yaml forces it off).
# ALLOW_DEMO_CONTROLS_IN_PRODUCTION (opt-in that keeps the controls in production mode) and
# DEMO_DISABLED_FAULTS exist for the hosted demonstration image only; compose.yaml does not
# pass them through. They are documented in docs/configuration.md.
DEMO_CONTROLS_ENABLED=true
# Backend -> demo app fault injection
DEMO_APP_CONTROL_TOKEN=dev-only-change-me-demo-control-token
# Worker -> demo app recovery endpoint (remediation ACTION-001)
DEMO_APP_RECOVERY_TOKEN=dev-only-change-me-demo-recovery-token

# --- VigilAI (Google Gemini) -----------------------------------------------------
# gemini | none.  Leave GEMINI_API_KEY empty to run VigilAI in documentation mode.
# Create a key at https://aistudio.google.com/  (free tier; do not enable billing).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Any text-generation model your key can use; change it without touching code.
GEMINI_MODEL=gemini-3.5-flash-lite
# Protect the free quota: per-user messages per minute, and a server-wide daily cap (0 = no cap).
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_REQUEST_LIMIT=400

# --- Optional ----------------------------------------------------------------------
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Only needed when the frontend is served from a different origin than the API.
# Not needed for Docker Compose or `npm run dev`: both proxy /api and stay same-origin.
CORS_ORIGINS=
# Advanced tuning (defaults shown; uncomment to change)
# ALERT_REPEAT_INTERVAL_SECONDS=120      # must equal repeat_interval in monitoring/alertmanager.yml
# REMEDIATION_WRITABLE_TARGETS=cloud-infrastructure.yaml
# REMEDIATION_MAX_ATTEMPTS=3
# ACTION_TIMEOUT_SECONDS=30
# VERIFY_TIMEOUT_SECONDS=150
# AI_TIMEOUT_SECONDS=20
# LOGIN_RATE_LIMIT_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# FORWARDED_ALLOW_IPS=*                  # addresses whose X-Forwarded-For header is trusted
# Local tool ports (bound to 127.0.0.1 only)
BACKEND_DEV_PORT=8000
PROMETHEUS_DEV_PORT=9090
ALERTMANAGER_DEV_PORT=9093

# --- Production only (compose.prod.yaml) -----------------------------------------
# Public DNS name of the server; Caddy obtains a TLS certificate for it automatically.
# VIGILOPS_DOMAIN=vigilops.example.com
